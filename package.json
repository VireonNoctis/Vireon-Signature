{
  "name": "vireon-signature",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain/*.test.mjs",
    "build": "vite build",
    "build:pages": "vite build --base=/Vireon-Signature/",
    "preview": "vite preview --host 0.0.0.0",
    "validate": "python3 scripts/validate.py && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@chenglou/pretext": "^1.0.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  }
}
